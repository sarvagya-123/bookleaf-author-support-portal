PORT=5000
NODE_ENV=development
CLIENT_ORIGINS=http://localhost:5173,https://bookleaf-author-support-portal-as5jii013.vercel.app

# Use a newly rotated PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Generate a new secret; do not reuse the value shown in the screenshot.
JWT_SECRET=replace-with-a-new-random-secret
ADMIN_SIGNUP_SECRET=replace-with-a-separate-admin-invitation-secret

# Optional for local development; AI replies fall back when this is unset.
OPENROUTER_API_KEY=
